# ============================================================
# TechNurture — environment variables
# Copy this file to `.env.local` and fill in the values, then
# restart the dev server (`npm run dev`).
#
# These three Supabase keys are the ONLY variables the app needs —
# the public site, the service booking, the enquiry form, the
# analytics tracker and the whole /admin dashboard all run on them.
# ============================================================

# --- Supabase -------------------------------------------------
# Find these in your Supabase project:
#   Dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" API key. Safe to expose to the browser; used for
# public inserts (enquiries, bookings, page views) and for admin login.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" secret key — SERVER ONLY, never exposed to the browser.
# Used by the /admin dashboard, the API routes and blog image uploads.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI chat agent --------------------------------------------
# Powers the website chat assistant (answers questions, captures leads
# into Inquiries + CRM, and creates bookings). SERVER ONLY.
# Get one at https://platform.openai.com/api-keys
# Without it, the chat widget still shows but politely points to phone/WhatsApp.
OPENAI_API_KEY=

# Which model answers customers. OPTIONAL — defaults to gpt-4o-mini.
#
# Measured on this assistant's own prompt (~7,350 input tokens a turn, so
# input cost dominates and the reply length barely matters):
#
#   gpt-4o-mini    ~$0.0006/turn   fast (3-12s)    the default
#   gpt-4.1-mini   ~$0.0010/turn   fast (3-10s)    recommended upgrade
#   gpt-5-mini     ~$0.0022/turn   slow (11-19s)   reasoning tokens, very wordy
#   gpt-5-nano     ~$0.0009/turn   slow (15-31s)   reasoning tokens, very wordy
#
# gpt-4.1-mini follows the prompt's rules more reliably (it holds the
# no-repair-price line and greets Tamil speakers correctly) at the same
# speed, for roughly 1.6x the cost — a few dollars a month at this volume.
# The gpt-5 tier is not worth it here: reasoning tokens make it slower AND
# dearer, and it writes paragraphs where a chat bubble wants a sentence.
#
# The prompt is deliberately laid out so its long, static part comes first
# and only the clock changes at the end — that keeps OpenAI's prompt cache
# hitting (~7,000 of the 7,350 tokens are billed at the cached rate). If
# you edit lib/ai/context.ts, keep anything time-varying at the bottom.
OPENAI_CHAT_MODEL=

# --- Live chat handoff email (OPTIONAL) -----------------------
# When a visitor asks to speak to a person, the admin ALWAYS flags it (a badge
# on "Live Chat"). Set these to ALSO get an email so you're pinged when away.
# Get a key at https://resend.com/api-keys and verify your domain in Resend.
RESEND_API_KEY=
# Where the "a visitor wants to talk" email is sent (defaults to site.email):
OWNER_NOTIFICATION_EMAIL=
# The verified Resend sender (defaults to noreply@<your domain>):
RESEND_FROM=

# ============================================================
# Setup checklist (do this once)
# ------------------------------------------------------------
# 1. Run the SQL migrations in supabase/migrations in order
#    (001 → 013) in the Supabase SQL editor. See supabase/README.md.
#      - 011_seed_blog.sql is optional (seeds the 5 starter posts).
#      - 012_ai_agent.sql powers the AI chat assistant.
#      - 013_live_chat.sql powers live chat + human handoff.
# 2. Create your admin login:
#      Authentication → Users → "Add user" (email + password).
# 3. Turn OFF public sign-ups so only you can add admins:
#      Authentication → Providers → Email → disable "Enable sign ups".
# 4. (Analytics) Visitor location is read from your host's geo headers.
#    Vercel and Cloudflare provide these automatically in production;
#    in local dev, location shows as "Unknown" (this is expected).
# ============================================================
